            "text": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Video Player</title>\n  <style>\n    body {\n      margin: 0;\n      padding: 0;\n    }\n\n    .video-js {\n      position: absolute;\n      height: 100% !important;\n      z-index: 99;\n      right: 0;\n      left: 0;\n    }\n\n.media-control[data-media-control] .media-control-background[data-background] {\n  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent) !important;\n  box-shadow: none !important;\n  height: 60px !important; /* 60px gibi bir yükseklik daha doğal bir geçiş sağlar */\n}\n  </style>\n</head>\n<body>\n  <div id=\"channel-detail\"></div>\n  <div id=\"player\"></div>\n  <script src=\"https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/clappr@latest/dist/clappr.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/gh/eniyiyayinci/redirect/player.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/level-selector/dist/level-selector.min.js\"></script>\n  <script>\n    const url_string = window.location.href;\n    const url = new URL(url_string);\n    const cid = url.searchParams.get(\"id\");\n    const ctitle = url.searchParams.get(\"title\");\n\n    const adsSrc = [\"https://video.twimg.com/amplify_video/1959320261745889280/pl/LMgAWlv0Pa04p9YD.m3u8?variant_version=1&tag=14\"];\n    const adsLink = [\"https://aff.xyzrdr.xyz/tr/sign-up?partner=p50001p51770p82e3\"];\n    const baseurl = \"https://ten.4928d54d950ee70q30.lat/\";\n    const kanalurl = {\n      1: \"yayin1.m3u8\", 2: \"yayinb2.m3u8\", 3: \"yayinb3.m3u8\",\n      4: \"yayinb4.m3u8\", 5: \"yayinb5.m3u8\", 6: \"yayinbm1.m3u8\",\n      7: \"yayinbm2.m3u8\", 8: \"yayinss.m3u8\", 9: \"yayinss2.m3u8\",\n      10: \"yayinssp2.m3u8\", 11: \"yayint1.m3u8\", 12: \"yayint2.m3u8\",\n      13: \"yayint3.m3u8\", 14: \"yayinsmarts.m3u8\", 15: \"yayinsms2.m3u8\",\n      16: \"yayintrtspor.m3u8\", 17: \"yayintrtspor2.m3u8\", 18: \"yayinas.m3u8\",\n      19: \"yayinatv.m3u8\", 20: \"yayintv8.m3u8\", 21: \"yayintv85.m3u8\",\n      22: \"yayinnbatv.m3u8\", 23: \"yayinex1.m3u8\", 24: \"yayinex2.m3u8\",\n      25: \"yayinex3.m3u8\", 26: \"yayinex4.m3u8\", 27: \"yayinex5.m3u8\",\n      28: \"yayinex6.m3u8\", 29: \"yayinex7.m3u8\", 30: \"yayinex8.m3u8\"\n    };\n\n    let adsg = cid + \".m3u8\";\n    let sexurl = baseurl + adsg;\n    if (/https/.test(cid)) {\n      sexurl = cid;\n    }\n\n    const rands = Math.floor(Math.random() * adsSrc.length);\n\n    window.config = {\n      adv: {\n        enabled: 1,\n        link: adsLink[rands],\n        parentId: \"div#player\",\n        width: '100%',\n        skipOffset: \"5\",\n        plugins: [LevelSelector],\n        source: adsSrc[rands],\n\t\tposter: \"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhIgm3VMRTqm1txBpkw1L0xly29VInNG8dCpGHOQIHbzM965akgqp-8Nu4AtUkDOsxCLPR-lSdo4W_LjMAzENEUJ1DZZ0pMLPRNOukylRbP_8HLSZ1QqOd5z-QniZBWRWU4QrUTUQtXwGFkpZnPxrRTD57Ojc86Lf4hUjMAnUvR24cBu67US-QcWwuX-yqP/s1280/bahsegel.png\"\n      },\n      match: {\n        parentId: \"div#player\",\n        watermark: \"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhDw7-UDZdivyPd3per9Zbd7USYMQGghR0SbCKVr6UXmH0CuQvck3G18pB5vBLg_SkzjWNLiXZNp4ccqbkbNG_vHogkuhf88vfLd4_EUs01tL9wf4Huf53qhMhBXLfEg3ZV9q7Xbb64EM0ur-arJGGUPzKzQfF_Zn1P_oxG9upWY-VBdZRWs-Wly6tRM5dl/s200/restbetlogo.jpeg\",\n        watermarkLink: \"https://cutt.ly/Me8dSJQ7\",\n        position: \"top-right\",\n        source: sexurl,\n        mimeType: \"application/x-mpegURL\",\n        mediacontrol: { seekbar: \"#49de80\" },\n        plugins: [LevelSelector],\n        width: '100%',\n        playback: {\n          playInline: true,\n          controls: Clappr.Browser.isiOS,\n\t\t  chromeless: Clappr.Browser.isiOS\n        }\n      }\n    };\n\n    $(document).ready(function () {\n      new Clappr.Player(window.config.match);\n\n      const video = $(\"body video\").get(0);\n      if (video) {\n        video.muted = false;\n        video.click().catch(function (error) {\n          console.log(\"Kullanıcı etkileşimi yok, oynatma engellendi:\", error);\n        });\n      }\n    });\n  </script>\n  <script>\n    document.addEventListener(\"contextmenu\", function (e) {\n      e.preventDefault();\n    }, false);\n  </script>\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;\n    if (isIOS) {\n      const style = document.createElement(\"style\");\n      style.innerHTML = `\n        .media-control[data-media-control] {\n          display: none !important;\n        }\n      `;\n      document.head.appendChild(style);\n    }\n  });\n</script>\n  <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-L5L8LCKEZE\"></script>\n  <script>\n    window.dataLayer = window.dataLayer || [];\n    function gtag() { dataLayer.push(arguments); }\n    gtag('js', new Date());\n    gtag('config', 'G-L5L8LCKEZE');\n  </script>\n  <div id=\"displayDivId\" style=\"display: none;\">\n    <iframe name=\"iFrame1\" width=\"1\" height=\"2\" src=\"/sayac.html\" scrolling=\"no\" frameborder=\"0\"></iframe>\n  </div>\n</body>\n</html>\n"
